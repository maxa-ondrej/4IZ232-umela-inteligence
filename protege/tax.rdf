            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#Kniha"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#napsalKnihu"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#Autor"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#máFormát"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#AudioFormát"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#délka"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


