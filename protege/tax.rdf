    <!-- http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#Audiokniha -->

    <owl:Class rdf:about="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#Audiokniha">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#Kniha"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#máFormát"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#AudioFormát"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cen57039/ontologies/2025/10/knihy#Kniha"/>
